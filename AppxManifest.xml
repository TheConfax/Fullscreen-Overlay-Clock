<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap17="http://schemas.microsoft.com/appx/manifest/uap/windows10/17"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 uap17 desktop rescap">

  <!-- Stamped at pack time from pyproject.toml (build_msix.py); every
       STAMPED-BY-BUILD-MSIX is an inert placeholder. -->
  <Identity
    Name="STAMPED-BY-BUILD-MSIX"
    Publisher="STAMPED-BY-BUILD-MSIX"
    Version="STAMPED-BY-BUILD-MSIX"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>STAMPED-BY-BUILD-MSIX</DisplayName>
    <PublisherDisplayName>STAMPED-BY-BUILD-MSIX</PublisherDisplayName>
    <Description>STAMPED-BY-BUILD-MSIX</Description>
    <Logo>icons\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>
    <uap17:UpdateWhileInUse>defer</uap17:UpdateWhileInUse>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <!-- One entry per catalog in src/i18n: this is what the Store lists the app as
       speaking. The first is the default when the user's language matches none. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="it-it" />
    <Resource Language="es-es" />
    <Resource Language="fr-fr" />
    <Resource Language="de-de" />
  </Resources>

  <Applications>
    <Application
      Id="STAMPED-BY-BUILD-MSIX"
      Executable="STAMPED-BY-BUILD-MSIX"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="STAMPED-BY-BUILD-MSIX"
        Description="STAMPED-BY-BUILD-MSIX"
        BackgroundColor="transparent"
        Square150x150Logo="icons\Square150x150Logo.png"
        Square44x44Logo="icons\Square44x44Logo.png" />

      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="STAMPED-BY-BUILD-MSIX"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="STAMPED-BY-BUILD-MSIX"
            Enabled="false"
            DisplayName="STAMPED-BY-BUILD-MSIX" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
